## Workspace definition ########################################################
#
# Root module of the public wispers-hub repo.

module(
    name = "wispers-hub",
    version = "0.3.0",
)

## Go SDK and module management ################################################

bazel_dep(name = "rules_go", version = "0.51.0")
bazel_dep(name = "gazelle", version = "0.39.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.3")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_gin_gonic_gin",
    "com_github_golang_jwt_jwt_v5",
    "com_github_google_uuid",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_time",
    "org_modernc_sqlite",
)

## Protocol buffers & gRPC #####################################################

bazel_dep(name = "rules_proto_grpc_go", version = "5.0.1")
bazel_dep(name = "toolchains_protoc", version = "0.4.1")
bazel_dep(name = "bazel_skylib", version = "1.5.0")

protoc = use_extension("@toolchains_protoc//protoc:extensions.bzl", "protoc")
protoc.toolchain(
    google_protobuf = "com_google_protobuf",
    version = "v27.2",
)
use_repo(protoc, "com_google_protobuf", "toolchains_protoc_hub")

register_toolchains("@toolchains_protoc_hub//:all")

## Packaging ###################################################################

bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "rules_oci", version = "2.2.6")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_static",
    digest = "sha256:3f2b64ef97bd285e36132c684e6b2ae8f2723293d09aae046196cca64251acac",
    image = "gcr.io/distroless/static",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(
    oci,
    "distroless_static",
    "distroless_static_linux_amd64",
    "distroless_static_linux_arm64_v8",
)

## The Wispers Connect client library ##########################################

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "connect_client",
    build_file = "//third_party:client.BUILD",
    sha256 = "bdb2295e0a79dc9c4b02f5d9c9e4a33a1d9940dc32aa111007860897973fddf4",
    strip_prefix = "wispers-client-0.11.0",
    urls = ["https://github.com/s-te-ch/wispers-client/archive/refs/tags/v0.11.0.tar.gz"],
)
